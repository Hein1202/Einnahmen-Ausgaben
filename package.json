{
  "name": "einnahmen-ausgaben",
  "productName": "Einnahmen-Ausgaben",
  "version": "234.4.26",
  "description": "Offline Einnahmen- und Ausgaben-Tracker (Electron)",
  "main": "electron/main.js",
  "author": "Heinrich",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "de.einnahmenausgaben.app",
    "productName": "Einnahmen-Ausgaben",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  }
}
